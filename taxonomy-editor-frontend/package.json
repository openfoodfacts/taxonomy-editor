{
  "name": "taxonomy-editor-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.13.0",
    "@material-table/core": "8.0.3",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/x-data-grid": "^9.16.0",
    "@tanstack/react-query": "^5.17.9",
    "@vitejs/plugin-react": "^6.1.1",
    "@yaireo/dragsort": "^1.3.1",
    "@yaireo/tagify": "4.17.9",
    "axios": "^1.18.0",
    "fast-deep-equal": "^3.1.3",
    "i18next": "^26.5.11",
    "iso-639-1": "^3.1.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-router-dom": "^7.18.3",
    "typescript": "^7.0.2",
    "web-vitals": "^6.2.3"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "serve": "vite preview",
    "prepare": "cd .. && husky install taxonomy-editor-frontend/.husky",
    "lint": "eslint --fix src/ && prettier --write .",
    "lint:check": "eslint --no-fix src/ && prettier --check .",
    "generate:api": "openapi --input ../backend/openapi/openapi.json --output ./src/client --client axios && prettier --write ./src/client"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.5",
    "lint-staged": "^17.6.0",
    "openapi-typescript-codegen": "^0.27.0",
    "prettier": "3.3.2",
    "vite": "^8.2.2",
    "vite-plugin-svgr": "^5.2.0",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "overrides": {
    "@material-table/core": {
      "uuid": "^11.1.1"
    }
  },
  "lint-staged": {
    "*.{js,css,md}": "prettier --write"
  }
}
