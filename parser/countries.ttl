@prefix wd: <http://www.wikidata.org/entity/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

off:countryCode2 a rdf:Property ;
    rdfs:domain off:Country ;
    rdfs:range xsd:string .

off:countryCode3 a rdf:Property ;
    rdfs:domain off:Country ;
    rdfs:range xsd:string .

off:ecobalyseIsPartOfEu a rdf:Property ;
    rdfs:domain off:Country ;
    rdfs:range xsd:string .

off:languageCodes a rdf:Property ;
    rdfs:domain off:Country ;
    rdfs:range xsd:string .

off:officialCountryCode2 a rdf:Property ;
    rdfs:domain off:Country ;
    rdfs:range xsd:string .

off:osmNode a rdf:Property ;
    rdfs:domain off:Country ;
    rdfs:range xsd:string .

off:osmRelation a rdf:Property ;
    rdfs:domain off:Country ;
    rdfs:range xsd:string .

off:osmWay a rdf:Property ;
    rdfs:domain off:Country ;
    rdfs:range xsd:string .

off:regionalEntity a rdf:Property ;
    rdfs:domain off:Country ;
    rdfs:range xsd:string .

off:wikidata a owl:ObjectProperty ;
    rdfs:domain off:Country ;
    rdfs:subPropertyOf skos:exactMatch .

