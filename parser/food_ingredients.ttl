        "Sole commune"@fr,
        "Sól coiteann"@ga,
        "linguado"@gl,
        "obični taban"@hr,
        "Soleo"@io,
        "Sogliola comune"@it,
        "Solea Solea"@la,
        "tunge"@nb,
        "Tong"@nl,
        "tunge"@nn,
        "sola zwyczajna"@pl,
        "Европейская солея"@ru,
