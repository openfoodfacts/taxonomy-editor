food_ingredients:brewer-s-yeast a off:FoodIngredient ;
    skos:altLabel "oluthiiva"@fi,
        "drożdże Saccharomyces Cerevisiae"@pl,
        "drożdże piwne"@pl,
        "drożdże piwowarskie"@pl ;
    skos:broader food_ingredients:yeast ;
    skos:definition "SACCHAROMYCES CEREVISIAE is a species of yeast. It has been instrumental to winemaking, baking, and brewing since ancient times. S. cerevisiae is used in baking; the carbon dioxide generated by the fermentation is used as a leavening agent in bread and other baked goods. Historically, this use was closely linked to the brewing industry's use of yeast, as bakers took or bought the barm or yeast-filled foam from brewing ale from the brewers (producing the barm cake); today, brewing and baking yeast strains are somewhat different."@en ;
    skos:inScheme off:food_ingredients ;
    skos:prefLabel "бирена мая"@bg,
        "pekarské drozdi"@cs,
        "Bierhefe"@de,
        "brewer's yeast"@en,
        "levadura de cerveza"@es,
