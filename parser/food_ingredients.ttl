food_ingredients:pepeao a off:FoodIngredient ;
    skos:altLabel "pepeiao"@en,
        "wood ear mushroom"@en ;
    skos:broader food_ingredients:mushroom ;
    skos:definition "Fresh pepeiao has a convex shape with a smooth, sometimes wrinkly surface, and can be a purply gray-brown color. It has a slightly chewy texture that many describe as rubbery-crunchy. It grows wild on logs of koa and kukui trees in Hawaii, typically on fallen or dying tree branches, often appearing after rain. It's known for its ability to absorb flavors when cooked and is commonly added to soups and stir-fries. It's a staple in Hawaii's Asian-influenced cuisine and is essentially the same category of mushroom used as \"wood ear\" or \"cloud ear\" in Chinese and Japanese cooking (sometimes called kikurage)."@en ;
    skos:inScheme off:food_ingredients ;
    skos:prefLabel "pepeao"@en,
        "Auricularia polytricha"@la ;
    off:usdaNdbCode "11230"@en ;
    off:usdaNdbName "Pepeao, dried"@en ;
    off:usdaNdbProcess "en:dried"@en .

food_ingredients:pepeiao a off:FoodIngredient ;
    skos:broader food_ingredients:mushroom ;
    skos:definition "\"Pepeao\" is a Hawaiian word — it literally means \"ear,\" and it's used in Hawaii to refer to a type of jelly fungus (wood ear mushroom, genus Auricularia) because of its ear-shaped, rubbery cap. It grows on dead or decaying wood and is edible, often used in soups and stir-fries, similar to how \"wood ear\" or \"cloud ear\" mushrooms are used in Chinese cuisine."@en ;
    skos:inScheme off:food_ingredients ;
    skos:prefLabel "pepeiao"@en,
        "Auricularia cornea"@la ;
    off:usdaNdbCode "11228"@en ;
    off:usdaNdbName "Jew's ear, (pepeao), raw"@en .

