food_ingredients:dishcloth a off:FoodIngredient ;
    skos:altLabel "luffa"@en,
        "sponge gourd"@en,
        "towelgourd"@en ;
    skos:broader food_ingredients:fruit-vegetable ;
    skos:definition "\"Dishcloth gourd\" (also called towel gourd, sponge gourd, or luffa) is the common name for Luffa — usually Luffa aegyptiaca (smooth luffa) or Luffa acutangula (angled/ridged luffa, sometimes called \"Chinese okra\"). It's a tropical vine in the cucumber/squash family, common in Asian, African, and some Mediterranean cuisines. The flesh is mild, slightly sweet, and a bit like a cross between zucchini and cucumber, with a spongy texture that softens when cooked."@en ;
    skos:inScheme off:food_ingredients ;
    skos:prefLabel "dishcloth"@en,
        "Luffa aegyptiaca"@la ;
    off:usdaNdbCode "11220"@en ;
    off:usdaNdbName "Gourd, dishcloth (towelgourd), raw"@en .

