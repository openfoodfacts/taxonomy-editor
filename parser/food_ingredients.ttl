food_ingredients:sweetcorn a off:FoodIngredient ;
    skos:altLabel "Süssmais"@de,
        "Zuckermais"@de,
        "sweet corn"@en,
        "sweet corn in kernels"@en,
        "tender sweet maize"@en,
