food_ingredients:chinese-yam a off:FoodIngredient ;
    skos:altLabel "Japanese mountain yam"@en,
        "hawaii mountain yam"@en,
        "onagaimo"@en,
        "satsuma imo"@en,
        "yamaimo"@en,
        "山芋"@ja,
        "長芋"@ja,
        "薯蕷"@zh ;
    skos:broader food_ingredients:yam ;
    skos:definition "Japanese mountain yam is native to China and Japan. Unlike most yams, it's often eaten raw — grated, it becomes sticky and mucilaginous (called tororo in Japanese cooking), used as a topping for rice, soba, or mixed into batters. It can also be cooked (steamed, boiled, fried)."@en ;
