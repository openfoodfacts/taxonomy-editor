        food_ingredients:starch ;
    skos:definition "Arrowroot starch is a starch obtained from the rhizomes (rootstock) of several tropical plants, traditionally Maranta arundinacea, but also Florida arrowroot from Zamia integrifolia, and tapioca from cassava (Manihot esculenta), which is often labelled as arrowroot."@en ;
    skos:inScheme off:food_ingredients ;
    skos:prefLabel "Pfeilwurzelstärke"@de,
        "arrowroot powder"@en ;
    off:usdaNdbCode "20003"@en ;
    off:usdaNdbName "Arrowroot flour"@en .

