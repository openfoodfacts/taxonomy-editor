food_ingredients:gai-lan a off:FoodIngredient ;
    skos:altLabel "chinese broccoli"@en,
        "chinese kale"@en,
        "gai-lan"@en,
        "kai-lan"@en,
        "kailan"@en,
        "kailaan"@fi,
        "kiinanbrokkoli"@fi,
        "kinesisk broccoli"@sv ;
    skos:broader food_ingredients:cabbage ;
    skos:definition "Chinese broccoli (also called gai lan or kai lan, 芥蓝) is actually a distinct vegetable from regular broccoli, though they're related. Both belong to the Brassica oleracea species and the broader cabbage family. Gai lan has long, thick green stalks with flat, broad leaves and small, scattered flower buds. Western broccoli has a large, compact floret head on a thick stalk. It's slightly more bitter and robust than regular broccoli, with an earthy, slightly peppery flavor."@en ;
    skos:inScheme off:food_ingredients ;
    skos:prefLabel "bròquil xinès"@ca,
        "kai-lan"@de,
        "gai lan"@en,
        "ĉina brokolo"@eo,
        "brassica oleracea var. alboglabra"@es,
        "kai-lan"@eu,
        "کلم‌برگ چینی"@fa,
        "härmekaali"@fi,
        "brocoli chinois"@fr,
