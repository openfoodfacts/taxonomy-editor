food_ingredients:arrowhead a off:FoodIngredient ;
    skos:broader food_ingredients:vegetable ;
    skos:definition "Arrowhead (also called Sagittaria, water arrowhead, or 慈姑 cí gū in Chinese) is an aquatic plant whose starchy corms (bulb-like root tubers) are eaten as a vegetable. It grows in shallow ponds, marshes, and rice paddies, and is especially popular in Chinese, Japanese, and Southeast Asian cooking. Mildly bitter and slightly sweet, with a starchy texture similar to a chestnut or potato. The bitterness mellows considerably with cooking."@en ;
    skos:inScheme off:food_ingredients ;
    skos:prefLabel "arrowhead"@en,
        "Sagittaria"@la,
        "慈姑"@zh ;
    off:usdaNdbCode "11005"@en ;
    off:usdaNdbName "Arrowhead, raw"@en .

