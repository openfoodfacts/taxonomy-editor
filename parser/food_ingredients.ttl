food_ingredients:mammy-apple a off:FoodIngredient ;
    skos:altLabel "mamey"@en ;
    skos:broader food_ingredients:fruit ;
    skos:definition "A mammy apple is a tropical fruit native to the Caribbean and tropical Americas. Despite the name, they are actually classified as a berry, not a true apple. The flesh is intensely aromatic and deep orange, with a flavour similar to an apricot or raspberry."@en ;
    skos:inScheme off:food_ingredients ;
    skos:prefLabel "mammy apple"@en,
